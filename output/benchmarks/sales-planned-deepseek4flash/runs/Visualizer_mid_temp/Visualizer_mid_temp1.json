        "sql_query": "WITH months AS (\n  SELECT g.generate_series::DATE AS month\n  FROM generate_series(TIMESTAMP '2023-01-01', TIMESTAMP '2023-12-31', INTERVAL '1 month') AS g\n),\nmonthly_sales AS (\n  SELECT DATE_TRUNC('month', s.Sold_Date)::DATE AS month,\n         ROUND(SUM(s.Total_Sale_Value), 2) AS total_revenue,\n         SUM(s.Qty_Sold) AS total_units_sold\n  FROM sales s\n  WHERE s.Sold_Date >= DATE '2023-01-01'\n    AND s.Sold_Date < DATE '2024-01-01'\n  GROUP BY DATE_TRUNC('month', s.Sold_Date)::DATE\n)\nSELECT m.month,\n       COALESCE(ms.total_revenue, 0) AS total_revenue,\n       COALESCE(ms.total_units_sold, 0) AS total_units_sold\nFROM months m\nLEFT JOIN monthly_sales ms ON m.month = ms.month\nORDER BY m.month;"
      },
