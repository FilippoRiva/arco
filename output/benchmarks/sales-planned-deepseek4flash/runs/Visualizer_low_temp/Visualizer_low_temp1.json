        "sql_query": "WITH RECURSIVE months(month_date) AS (\n    SELECT DATE '2023-01-01'\n    UNION ALL\n    SELECT CAST(m.month_date + INTERVAL '1 month' AS DATE)\n    FROM months m\n    WHERE m.month_date < DATE '2023-12-01'\n),\nmonthly_sales AS (\n    SELECT\n        CAST(DATE_TRUNC('month', s.Sold_Date) AS DATE) AS month_date,\n        ROUND(SUM(s.Total_Sale_Value), 2) AS total_revenue_usd,\n        SUM(s.Qty_Sold) AS total_units_sold\n    FROM sales s\n    WHERE EXTRACT(YEAR FROM s.Sold_Date) = 2023\n    GROUP BY CAST(DATE_TRUNC('month', s.Sold_Date) AS DATE)\n)\nSELECT\n    m.month_date AS month,\n    COALESCE(ms.total_revenue_usd, 0) AS total_revenue_usd,\n    COALESCE(ms.total_units_sold, 0) AS total_units_sold\nFROM months m\nLEFT JOIN monthly_sales ms\n    ON m.month_date = ms.month_date\nORDER BY m.month_date;"
      },
