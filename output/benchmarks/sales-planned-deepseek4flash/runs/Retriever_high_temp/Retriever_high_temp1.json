        "sql_query": "WITH monthly_sales AS (\n    SELECT CAST(DATE_TRUNC('month', s.Sold_Date) AS DATE) AS month,\n           ROUND(SUM(s.Total_Sale_Value), 2) AS total_revenue,\n           SUM(s.Qty_Sold) AS total_units_sold\n    FROM sales s\n    WHERE s.Sold_Date >= DATE '2023-01-01'\n      AND s.Sold_Date <  DATE '2024-01-01'\n    GROUP BY 1\n),\nmonths AS (\n    SELECT CAST(range AS DATE) AS month\n    FROM range(DATE '2023-01-01', DATE '2024-01-01', INTERVAL 1 MONTH)\n)\nSELECT m.month,\n       COALESCE(ms.total_revenue, 0) AS total_revenue,\n       COALESCE(ms.total_units_sold, 0) AS total_units_sold\nFROM months m\nLEFT JOIN monthly_sales ms ON m.month = ms.month\nORDER BY m.month;"
      },
