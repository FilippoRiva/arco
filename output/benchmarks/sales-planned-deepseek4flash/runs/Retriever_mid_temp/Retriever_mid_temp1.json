        "data_df": "   month_start  total_revenue_usd  total_units_sold\n0   2023-01-01          434172.81             33653\n1   2023-02-01          411762.72             31545\n2   2023-03-01          423070.84             32460\n3   2023-04-01          384479.68             30199\n4   2023-05-01          381326.43             31154\n5   2023-06-01          364806.74             29082\n6   2023-07-01          353284.21             27932\n7   2023-08-01          401061.54             31903\n8   2023-09-01          422554.97             31847\n9   2023-10-01          454231.06             38208\n10  2023-11-01          511104.29             41043\n11  2023-12-01          874263.67             60941",
        "sql_query": "WITH months AS (\n  SELECT DATE '2023-01-01' + (i * INTERVAL '1' MONTH) AS month\n  FROM range(12) t(i)\n),\nmonthly_sales AS (\n  SELECT\n    DATE_TRUNC('month', s.Sold_Date)::DATE AS month,\n    SUM(s.Total_Sale_Value) AS total_revenue,\n    SUM(s.Qty_Sold) AS total_units_sold\n  FROM sales s\n  WHERE EXTRACT(YEAR FROM s.Sold_Date) = 2023\n  GROUP BY 1\n)\nSELECT\n  m.month,\n  COALESCE(ms.total_revenue, 0) AS total_revenue,\n  COALESCE(ms.total_units_sold, 0) AS total_units_sold\nFROM months m\nLEFT JOIN monthly_sales ms ON m.month = ms.month\nORDER BY m.month;"
      },
